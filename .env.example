ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_PAPER=true

OPENAI_API_KEY=
OPENAI_MODEL=

# Optional legacy model provider. OpenAI is the production classifier.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Deprecated legacy alias for ANTHROPIC_MODEL.
MODEL_CLASSIFIER_MODEL=

# Optional plug-in news source (transport lives on backup/pre-cleanup branch).
BENZINGA_API_KEY=

DATABASE_URL=sqlite://./data/exalted_fable.sqlite
# Days of raw audit data (provider payloads, raw model responses, account
# snapshots) kept before scripts/compactDatabase.js --apply nulls/prunes them.
# Learning evidence (trades, outcomes, price reactions) is kept forever.
RETENTION_RAW_DAYS=90
LIVE_TRADING_ENABLED=false
PAPER_ENABLE_SHORTS=false
# PAPER options (long calls/puts with monitored exits) are ON by default.
# Set to false to trade equities only.
PAPER_ENABLE_OPTIONS=true
PAPER_ENABLE_MARGIN=false

# Monitored PAPER option execution (long calls/puts only). Percentages are
# fractions (0.5 = 50%); *_MIN values are whole minutes. TP/SL are the
# LEARNING BASE — with enough confirmed option outcomes the exit engine
# re-derives them each cycle inside hard rails. Positions are force-closed
# before market close (no overnight options).
PAPER_OPTION_TP_PCT=0.5
PAPER_OPTION_SL_PCT=0.5
PAPER_OPTION_MAX_HOLD_MIN=240
PAPER_OPTION_ENTRY_TIMEOUT_MIN=10
PAPER_OPTION_EXIT_RETRY_MIN=5
PAPER_OPTION_NO_ENTRY_BEFORE_CLOSE_MIN=30
PAPER_OPTION_FORCE_CLOSE_BEFORE_CLOSE_MIN=15
PAPER_OPTION_LIMIT_SLIPPAGE_PCT=0.05

# Risk limits (all enforced; strategy settings / CLI flags can only tighten
# or override per run):
# - MAX_DAILY_LOSS_PCT: PREFERRED kill-switch cap as a fraction of broker
#   equity (0.01 = 1%; on a $1,000,000 paper account that is $10,000/day).
#   When the day's broker-confirmed realized loss breaches it, the kill
#   switch halts all new paper trades for the rest of the UTC day.
#   Manual control: node scripts/setKillSwitch.js --status|--on|--off.
# - MAX_DAILY_LOSS_USD: fixed-dollar FALLBACK used only when broker equity
#   is unavailable (e.g. keyless dry runs).
# - MAX_POSITION_SIZE_USD  -> default per-order notional cap
# - MAX_TRADES_PER_DAY     -> default daily paper-order count cap
# - MAX_TOTAL_EXPOSURE_USD -> default gross exposure cap
MAX_DAILY_LOSS_PCT=0.01
MAX_DAILY_LOSS_USD=100
MAX_POSITION_SIZE_USD=500
MAX_TRADES_PER_DAY=10
MAX_TOTAL_EXPOSURE_USD=1000

# Discord delivery for end-of-day PAPER reports.
# Create a channel webhook in Discord: Server Settings -> Integrations ->
# Webhooks -> New Webhook -> pick the channel -> Copy Webhook URL.
# The webhook URL is a SECRET (it embeds a token) — never commit it.
# Server/channel IDs are non-secret metadata (printed for sanity checks only;
# they cannot post on their own — only DISCORD_WEBHOOK_URL can send).
DISCORD_WEBHOOK_URL=
DISCORD_SERVER_ID=
DISCORD_CHANNEL_ID=
