ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_PAPER=true

OPENAI_API_KEY=
OPENAI_MODEL=

# Optional legacy model provider. OpenAI is the production classifier.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Deprecated legacy alias for ANTHROPIC_MODEL.
MODEL_CLASSIFIER_MODEL=

# Optional plug-in news source (transport lives on backup/pre-cleanup branch).
BENZINGA_API_KEY=

DATABASE_URL=sqlite://./data/exalted_fable.sqlite
# Days of raw audit data (provider payloads, raw model responses, account
# snapshots) kept before scripts/compactDatabase.js --apply nulls/prunes them.
# Learning evidence (trades, outcomes, price reactions) is kept forever.
RETENTION_RAW_DAYS=90
LIVE_TRADING_ENABLED=false
PAPER_ENABLE_SHORTS=false
PAPER_ENABLE_MARGIN=false

# Risk limits (all enforced; strategy settings / CLI flags can only tighten
# or override per run):
# - MAX_DAILY_LOSS_USD: broker-confirmed realized daily loss that TRIPS the
#   kill switch (halts all new paper trades for the rest of the UTC day;
#   manual control: node scripts/setKillSwitch.js --status|--on|--off).
# - MAX_POSITION_SIZE_USD  -> default per-order notional cap
# - MAX_TRADES_PER_DAY     -> default daily paper-order count cap
# - MAX_TOTAL_EXPOSURE_USD -> default gross exposure cap
MAX_DAILY_LOSS_USD=100
MAX_POSITION_SIZE_USD=500
MAX_TRADES_PER_DAY=10
MAX_TOTAL_EXPOSURE_USD=1000

# Discord delivery for end-of-day PAPER reports.
# Create a channel webhook in Discord: Server Settings -> Integrations ->
# Webhooks -> New Webhook -> pick the channel -> Copy Webhook URL.
# The webhook URL is a SECRET (it embeds a token) — never commit it.
# Server/channel IDs are non-secret metadata (printed for sanity checks only;
# they cannot post on their own — only DISCORD_WEBHOOK_URL can send).
DISCORD_WEBHOOK_URL=
DISCORD_SERVER_ID=
DISCORD_CHANNEL_ID=
