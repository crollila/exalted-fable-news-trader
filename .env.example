ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_PAPER=true

OPENAI_API_KEY=
OPENAI_MODEL=

# Optional legacy model provider. OpenAI is the production classifier.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Deprecated legacy alias for ANTHROPIC_MODEL.
MODEL_CLASSIFIER_MODEL=

BENZINGA_API_KEY=
POLYGON_API_KEY=
ALPHA_VANTAGE_API_KEY=

DATABASE_URL=sqlite://./data/exalted_fable.sqlite
LIVE_TRADING_ENABLED=false
PAPER_ENABLE_SHORTS=false
PAPER_ENABLE_OPTIONS=false
PAPER_ENABLE_MARGIN=false

# Monitored PAPER option execution (long calls/puts only). Order submission still
# requires PAPER_ENABLE_OPTIONS=true AND --allow-options --options-mode execute_paper
# AND --execute-paper AND a valid market session. Percentages are fractions
# (0.5 = 50%); *_MIN values are whole minutes. Conservative, bounded defaults:
PAPER_OPTION_TP_PCT=0.5
PAPER_OPTION_SL_PCT=0.5
PAPER_OPTION_MAX_HOLD_MIN=240
PAPER_OPTION_ENTRY_TIMEOUT_MIN=10
PAPER_OPTION_EXIT_RETRY_MIN=5
PAPER_OPTION_NO_ENTRY_BEFORE_CLOSE_MIN=30
PAPER_OPTION_FORCE_CLOSE_BEFORE_CLOSE_MIN=15
PAPER_OPTION_LIMIT_SLIPPAGE_PCT=0.05

MAX_DAILY_LOSS_USD=100
MAX_POSITION_SIZE_USD=500
MAX_TRADES_PER_DAY=10
MAX_TOTAL_EXPOSURE_USD=1000

# Discord delivery for end-of-day PAPER reports.
# Create a channel webhook in Discord: Server Settings -> Integrations ->
# Webhooks -> New Webhook -> pick the channel -> Copy Webhook URL.
# The webhook URL is a SECRET (it embeds a token) — never commit it.
# Server/channel IDs are non-secret metadata (printed for sanity checks only;
# they cannot post on their own — only DISCORD_WEBHOOK_URL can send).
DISCORD_WEBHOOK_URL=
DISCORD_SERVER_ID=
DISCORD_CHANNEL_ID=
